# Copiare in .env e compilare. Letto da docker compose.

# chiave che l'app manda nell'header X-API-Key (obbligatoria; lunga e casuale)
API_KEY=

# script: solo regole, meno di un secondo per avviso
# modello: passa dal modello (avviare con: docker compose --profile modello up -d)
MODALITA=modello
# con MODALITA=modello avvia anche il servizio llm, cosi' basta "docker compose up -d"
COMPOSE_PROFILES=modello

# porta esposta sulla macchina
PORTA=8080

# modello: file in modelli/, nome, temperatura, attesa massima di una risposta
LLM_GGUF=Ministral-3-3B-Instruct-2512-Q4_K_M.gguf
LLM_MODEL=ministral-3-3b
LLM_TEMPERATURE=0
LLM_TIMEOUT=300s

# attesa massima dello script per un avviso (scaricamento della pagina compreso)
SCRIPT_TIMEOUT=120s
